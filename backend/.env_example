# Copy to services/<name>/.env (each service reads .env from its working directory).

# ---- shared ---------------------------------------------------------------
# Same secret in every service: identity signs access tokens, all services verify them.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
LOG_LEVEL=info
# 0.0.0.0 in containers; 127.0.0.1 on a machine with a public IP
HOST=0.0.0.0
# log | memory | nats. nats sends events to every service over NATS_URL (needed so that, e.g., a
# suspended user is refused by all services at once). `npm run dev` starts NATS and uses it
# whatever this says; `npm run nats` starts NATS on its own.
EVENT_BUS_DRIVER=log
NATS_URL=nats://127.0.0.1:4222

# ---- identity (port 3501) ---------------------------------------------------
PORT=3501
# postgres | memory   (memory = no database, dev only, data lost on restart)
IDENTITY_STORE=postgres
DB_CONNECTION_STRING=postgres://lrfe:lrfe@localhost:5432/lrfe
DB_POOL_SIZE=5
# Dev/UAT only: create the "identity" schema and tables on boot. Use migrations in production.
DB_SYNC=true
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_COOKIE_PATH=/api/auth
# false only for local http://localhost development
COOKIE_SECURE=false
# First administrator, created only when there are no users yet
BOOTSTRAP_ADMIN_NAME=System administrator
BOOTSTRAP_ADMIN_EMAIL=admin@deeds.gov.na
BOOTSTRAP_ADMIN_PASSWORD=change-me-please-now
# Set to seed the 14 fictitious demo users from the frontend with this password
SEED_DEMO_PASSWORD=
# Dev only: return the invitation link to the admin in the API response
IDENTITY_EXPOSE_INVITE_LINKS=true
# Quoted: dotenv treats an unquoted # as the start of a comment
IDENTITY_INVITE_URL_BASE="http://localhost:4200/#/invite"
# Outgoing email (invitations): smtp | file (dev: writes .eml files) | none (admin passes the link on)
MAIL_TRANSPORT=none
# Sender as recipients see it; the address must be allowed to send through the SMTP server
MAIL_FROM="Deeds Registry <noreply@example.com>"
MAIL_REPLY_TO=
# smtp: e.g. Google Workspace smtp.gmail.com:587 (account + app password), Elastic Email
# smtp.elasticemail.com:2525. 587/2525 upgrade to TLS (required); 465 is TLS from the start.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true by default; false only for a relay on the same machine without TLS (local Postfix on 25)
SMTP_REQUIRE_TLS=true
# This server's FQDN for the SMTP greeting (EHLO); without one Google's relay answers "421 Try again later"
SMTP_HELO_NAME=
# 4: always connect over IPv4 (a relay that allows this server by its IPv4 address); empty: either
SMTP_FAMILY=
MAIL_FILE_DIR=./tmp/mail

# ---- edrms (port 3502) ------------------------------------------------------
# PORT=3502
# postgres | memory (metadata);  DB_CONNECTION_STRING / DB_SYNC as above
EDRMS_STORE=postgres
# s3 | local | memory (content)
EDRMS_STORAGE=s3
# local: keep files outside the repository (git clean / a fresh clone would lose them) and back it up,
# e.g. /home/<user>/data/cportal-lrfe/edrms-store
EDRMS_LOCAL_DIR=./tmp/edrms-store
AWS_BUCKET_NAME=
AWS_BUCKET_REGION=
# Optional: without keys the AWS SDK default credential chain is used (IAM role, profile…)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EDRMS_MAX_FILE_MB=200
EDRMS_URL_TTL_SECONDS=300
EDRMS_COUNTRY_CODE=NA
# Encrypt stored files with keys from OpenBao (packages/storage/README.md): off | bao | fake
# (fake = in-memory keys for tests; files cannot be read after a restart). Read by edrms from API-638.
EDRMS_ENCRYPTION=off
# bao: the vault and this service's AppRole (secret ID in a file only this service's user can read)
# BAO_ADDR=http://127.0.0.1:8200
# BAO_ROLE_ID=
# BAO_SECRET_ID_FILE=
# BAO_KEY_NAME=edrms-files
EDRMS_REGISTRY_CODE=WDH
# Browser-facing path of signed content links (local/memory storage), and their HMAC key
EDRMS_CONTENT_URL_BASE=/api/document-content
EDRMS_CONTENT_URL_SECRET=

# ---- bpm (port 3503) --------------------------------------------------------
# PORT=3503
# postgres | memory;  DB_CONNECTION_STRING / DB_SYNC as above
BPM_STORE=postgres
# bpm calls edrms directly (not through the gateway) with a service token
# EDRMS_URL=http://localhost:3502

# ---- intake (port 3504) -----------------------------------------------------
# PORT=3504
# postgres | memory;  DB_CONNECTION_STRING / DB_SYNC as above
INTAKE_STORE=postgres
# s3 | local | memory (scans awaiting review)
INTAKE_STORAGE=local
# local: keep files outside the repository and back it up, e.g. /home/<user>/data/cportal-lrfe/intake-store
INTAKE_LOCAL_DIR=./tmp/intake-store
INTAKE_MAX_FILE_MB=50
# mock | gemini   (mock = canned answer, no API key, no cost)
EXTRACTION_PROVIDER=mock
GEMINI_API_KEY=
# intake files verified documents into edrms directly, with a service token
# EDRMS_URL=http://localhost:3502
# Run the extraction worker inside the service (false when `npm run worker` runs separately)
INTAKE_RUN_WORKER=true
# Encrypt stored files with keys from OpenBao (packages/storage/README.md): off | bao | fake
# (fake = in-memory keys for tests; files cannot be read after a restart). Read by intake from API-639.
INTAKE_ENCRYPTION=off
# bao: the vault and this service's AppRole (secret ID in a file only this service's user can read)
# BAO_ADDR=http://127.0.0.1:8200
# BAO_ROLE_ID=
# BAO_SECRET_ID_FILE=
# BAO_KEY_NAME=intake-files
# Jev (TypeSafe) judges what Gemini read; off by default. Without a key it stays off.
# Jev runs in the US: real deed text needs data-protection approval before enabling it.
JEV_ENABLED=false
# typesafe | fake   (fake = fixed answers, nothing sent)
JEV_PROVIDER=typesafe
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=5000
# Probabilities: mark a field "check" from JEV_FLAG_AT, re-read the document from JEV_ESCALATE_AT
# (measured on the sample documents, API-621; check again on real documents)
JEV_FLAG_AT=0.8
JEV_ESCALATE_AT=0.9

# ---- land-records (port 3505) -----------------------------------------------
# PORT=3505
# postgres | memory;  DB_CONNECTION_STRING / DB_SYNC as above
RECORDS_STORE=postgres
# record numbers LR-<code>-<year>-<number>
RECORDS_COUNTRY_CODE=NA
# documents are found and read in edrms, with a land-records service token
# EDRMS_URL=http://localhost:3502

# ---- gateway (port 3500) ----------------------------------------------------
# PORT=3500
IDENTITY_URL=http://localhost:3501
EDRMS_URL=http://localhost:3502
BPM_URL=http://localhost:3503
INTAKE_URL=http://localhost:3504
RECORDS_URL=http://localhost:3505
CORS_ORIGINS=http://localhost:4200
