{
  "key": "audit-finding",
  "name": "Audit finding",
  "description": "An auditor raised a finding on a record version or a document version. The people the product names acknowledge it in their task inbox, one task per role. The finding stays open in the audit service until a newer reviewed version resolves it or the auditor closes it; then the audit service withdraws this process if it is still open. Started by the audit service (API-659).",
  "start": {"services": ["audit"]},
  "managePerm": "audit.signoff",
  "businessKey": {"var": "finding.id"},
  "variables": {
    "type": "object",
    "additionalProperties": false,
    "required": ["finding", "raisedBy"],
    "properties": {
      "finding": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "about"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "description": {"type": "string", "minLength": 1, "maxLength": 4000},
          "about": {"type": "string"}
        }
      },
      "record": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "recordNo", "label", "versionNumber"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "recordNo": {"type": "string"},
          "label": {"type": "string"},
          "versionNumber": {"type": "integer", "minimum": 1}
        }
      },
      "document": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "edrmsNo", "title", "currentVersion"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "edrmsNo": {"type": "string"},
          "title": {"type": "string"},
          "currentVersion": {"type": "integer", "minimum": 1}
        }
      },
      "raisedBy": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string"}
        }
      }
    }
  },
  "startAt": "start",
  "acknowledgeTask": {
    "title": {"cat": ["Audit finding on ", {"var": "finding.about"}]},
    "outcomes": ["acknowledged"],
    "dueInHours": 120
  },
  "nodes": {
    "done": {"type": "end", "outcome": "acknowledged"}
  }
}
