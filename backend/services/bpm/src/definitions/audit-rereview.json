{
  "key": "audit-rereview",
  "name": "Audit: changed since review",
  "description": "A record version or a document version in it no longer matches the blockchain: it changed since it was reviewed and submitted, so it cannot be audited as true. The people the product names acknowledge it in their task inbox, one task per role, and correct what changed. Started by the audit service once per changed item (API-680).",
  "start": {"services": ["audit"]},
  "managePerm": "audit.signoff",
  "businessKey": {"var": "alert.key"},
  "variables": {
    "type": "object",
    "additionalProperties": false,
    "required": ["alert", "record"],
    "properties": {
      "alert": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "about", "message"],
        "properties": {
          "key": {"type": "string", "minLength": 1, "maxLength": 200},
          "about": {"type": "string"},
          "message": {"type": "string"}
        }
      },
      "record": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "recordNo", "label"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "recordNo": {"type": "string"},
          "label": {"type": "string"}
        }
      }
    }
  },
  "startAt": "start",
  "acknowledgeTask": {
    "title": {
      "cat": ["Re-review: changed since review, ", {"var": "alert.about"}]
    },
    "outcomes": ["acknowledged"],
    "dueInHours": 120
  },
  "nodes": {
    "done": {"type": "end", "outcome": "acknowledged"}
  }
}
