{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "land-registry": {
      "projectType": "application",
      "root": "projects/land-registry",
      "sourceRoot": "projects/land-registry/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/land-registry",
            "allowedCommonJsDependencies": ["qrcode", "dijkstrajs"],
            "index": "projects/land-registry/src/index.html",
            "browser": "projects/land-registry/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "projects/land-registry/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/land-registry/public"
              }
            ],
            "styles": [
              "projects/platform/src/styles/theme.css",
              "projects/platform/src/styles/app.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1mb",
                  "maximumError": "2mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "16kb",
                  "maximumError": "32kb"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "land-registry:build:production"
            },
            "development": {
              "buildTarget": "land-registry:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "shipping": {
      "projectType": "application",
      "root": "projects/shipping",
      "sourceRoot": "projects/shipping/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/shipping",
            "index": "projects/shipping/src/index.html",
            "browser": "projects/shipping/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "projects/shipping/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/shipping/public"
              }
            ],
            "styles": [
              "projects/platform/src/styles/theme.css",
              "projects/platform/src/styles/app.css"
            ],
            "allowedCommonJsDependencies": ["qrcode", "dijkstrajs"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1mb",
                  "maximumError": "2mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "16kb",
                  "maximumError": "32kb"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json",
            "port": 4201
          },
          "configurations": {
            "production": {
              "buildTarget": "shipping:build:production"
            },
            "development": {
              "buildTarget": "shipping:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "platform": {
      "projectType": "library",
      "root": "projects/platform",
      "sourceRoot": "projects/platform/src",
      "prefix": "app"
    }
  },
  "cli": {
    "analytics": false
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
