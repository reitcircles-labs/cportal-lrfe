# Settings of one site. Copy to .env next to docker-compose.yml, fill in, and keep it private:
#   cp .env.example .env && chmod 600 .env
# Every setting of a site and every secret is set here and nowhere else.

# ---- the version to run (the images' tag, e.g. from the export bundle's name) ----
LRFE_VERSION=

# ---- where users open the portal ----
# The address in invitation emails, e.g. https://deeds.example.gov (no trailing slash)
LRFE_PUBLIC_URL=
# The web app's port on this machine. 127.0.0.1 = only a reverse proxy on this machine (with
# HTTPS) can reach it, the normal case; 0.0.0.0 = every network of this machine.
LRFE_BIND=127.0.0.1
LRFE_HTTP_PORT=8080
# true behind HTTPS; false only for a test install opened over plain http://
COOKIE_SECURE=true

# ---- the organisation running the portal ----
# Shown in the screens, the invitation emails, the authenticator app's entry and evidence packs.
# Empty = not shown (the name: "Deeds Registry"). Display texts only, never a secret.
LRFE_ORG_NAME=Deeds Registry
LRFE_ORG_SUBTITLE=Republic of Namibia
# on the sign-in page, under the name
LRFE_ORG_PARENT=Ministry of Agriculture, Fisheries, Water and Land Reform
LRFE_ORG_PLACE=Windhoek
# The offices created on an empty database, as CODE=Name pairs separated by ";" (codes of 2 to 5
# capital letters). Empty = none: the administrator adds them (Administration → Offices).
LRFE_OFFICES=WDH=Deeds Registry · Windhoek;REH=Deeds Registry · Rehoboth

# ---- the registry ----
LRFE_COUNTRY_CODE=NA
# The deeds office's code: it appears in batch and document numbers
LRFE_REGISTRY_CODE=WDH

# ---- ownership extracts ----
# The public check page an extract's QR code opens (the token is added after a "/").
# Empty = <LRFE_PUBLIC_URL>/#/check
LRFE_EXTRACT_CHECK_URL=
# What an extract certifies, in the registry's words (one line). Empty = a placeholder saying the
# wording is still to be confirmed by the registry's legal advisers.
LRFE_EXTRACT_LEGAL_TEXT=
# The registry's coat of arms printed beside its name on extracts: a PNG or JPEG file on this
# machine, e.g. ./coat-of-arms.png. Empty = none
LRFE_COAT_OF_ARMS=
# The time zone of the dates printed on extracts, e.g. Africa/Windhoek. Empty = UTC
LRFE_TIME_ZONE=
# The organisation seal on extracts: bao = its key in OpenBao (profile bao, README.md part D).
# Empty = no seal: no extract can be issued.
LRFE_SEAL=
# The registry's seal certificate for that key, PEM on one line with \n for each line break
LRFE_SEAL_CERT=

# ---- secrets (generate each: openssl rand -base64 48 | tr -dc 'A-Za-z0-9') ----
# Signs every sign-in token. Anyone who knows it can act as anyone: random, secret, never reused.
JWT_SECRET=

# ---- the database ----
# The bundled PostgreSQL (profile postgres in COMPOSE_PROFILES below, the default) creates this
# user and database on its first start. For an existing PostgreSQL server instead: remove postgres
# from COMPOSE_PROFILES, set POSTGRES_HOST and the rest to that server's (README.md, "An existing
# PostgreSQL server").
POSTGRES_PASSWORD=
POSTGRES_USER=lrfe
POSTGRES_DB=lrfe
# empty = the bundled database
POSTGRES_HOST=
POSTGRES_PORT=5432
# appended to the connection address, e.g. ?sslmode=require for a server that requires TLS
POSTGRES_URL_OPTIONS=

# ---- the first administrator, created once on an empty database ----
BOOTSTRAP_ADMIN_NAME=System administrator
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Never on a site: demo users with this password (developers' test systems only)
SEED_DEMO_PASSWORD=

# ---- invitation email: smtp | none ----
MAIL_TRANSPORT=smtp
MAIL_FROM=
MAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_REQUIRE_TLS=true
# Shows the invitation link to the administrator too: only while email is not set up yet
IDENTITY_EXPOSE_INVITE_LINKS=false

# ---- reading scanned documents ----
# gemini = the AI reads the scans (needs GEMINI_API_KEY); mock = a canned answer, testing only
EXTRACTION_PROVIDER=gemini
GEMINI_API_KEY=
EXTRACTION_MONTHLY_BUDGET_USD=50
# The automatic cross-check of what was read (backend/services/intake/README.md in the source repository)
JEV_ENABLED=false
JEV_PROVIDER=
JEV_MODEL=
TYPESAFE_API_KEY=

# ---- storage of filed documents: local (the edrms-files volume) | s3 ----
EDRMS_STORAGE=local
AWS_BUCKET_NAME=
AWS_BUCKET_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- parts that run (README.md) ----
# postgres = the bundled database (leave it out only with an existing server: POSTGRES_HOST);
# bao = OpenBao (encrypted files, the wallet key); blockchain = a blockchain node for anchoring;
# docs = the API docs (Swagger UI) on LRFE_DOCS_PORT, e.g. for a demo or the site's developers.
# Example: COMPOSE_PROFILES=postgres,bao,blockchain
COMPOSE_PROFILES=postgres
# The API docs' port on this machine (profile docs), on LRFE_BIND like the web app
LRFE_DOCS_PORT=3510
# off | bao (needs the profile bao, prepared with: docker compose run --rm openbao-setup)
EDRMS_ENCRYPTION=off
INTAKE_ENCRYPTION=off
EXTRACTS_ENCRYPTION=off
# Anchoring on the blockchain: empty = off; ogmios = through the node (profiles bao and blockchain)
CARDANO_PROVIDER=
CARDANO_NETWORK=preview
ANCHOR_PERIOD=1h
ANCHOR_MIN_BALANCE_ADA=5

LOG_LEVEL=info
